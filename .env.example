APP_NAME="Arah GPCH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://arahgpch.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- MySQL / MariaDB (bawaan Laragon: user root, tanpa kata sandi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arahgpch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# produksi (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="arah@grandpasundanhotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Arah GPCH (edisi DHASTRAM)
DHASTRAM_TERMS=umum
DHASTRAM_BRAND_NAME="Arah GPCH"
DHASTRAM_BRAND_TAGLINE="Manajemen Strategi Grand Pasundan"
DHASTRAM_DEMO_ENABLED=false
DHASTRAM_AUDIT_ENABLED=true
DHASTRAM_COMPANY_CODE=GPCH
# Kirim notifikasi juga lewat email (butuh MAIL_* yang benar)
ARAH_NOTIFY_MAIL=false
# Wajibkan 2FA (aplikasi autentikator) untuk GM, Tim Pengawas & admin
ARAH_MFA_REQUIRED=false
# Muat data awal GPCH walau APP_ENV=production (hanya untuk instalasi pertama)
ARAH_SEED_GPCH=false
